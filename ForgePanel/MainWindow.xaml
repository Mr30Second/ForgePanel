<Window x:Class="ForgePanel.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:local="clr-namespace:ForgePanel"
 Title="ForgePanel" Width="1280" Height="1255" MinWidth="980" MinHeight="620"
 Icon="Assets/app-icon.png"
 WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
 FontFamily="Segoe UI"
 PreviewKeyDown="Window_PreviewKeyDown"
 UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- WindowChrome возвращает окну корректную геометрию: развёрнутое окно становится по рабочей области,
         а не поверх панели задач, и остаётся возможным перетаскивание за край (Aero Snap). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Только стиль кнопок шапки. Общий стиль Button живёт в App.xaml в единственном экземпляре. -->
        <Style x:Key="CaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="MaximizeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame" BorderBrush="{StaticResource FrameLine}" BorderThickness="1" Background="{StaticResource Bg}">
        <Border.Style>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <!-- В развёрнутом состоянии окно выходит за границы экрана на толщину невидимой рамки изменения размера. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBg}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="11,11,0,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                <Setter Property="CornerRadius" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <!-- Значок панели вместо кирки: картинка та же, что у окна и у .exe.
                             DecodePixelWidth нужен потому, что исходник — 256 пикселей, и без
                             него WPF развернул бы его в память целиком ради квадрата в 20 DIP;
                             40 = запас на случай масштаба экрана 200 %. -->
                        <Image Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center" Stretch="Uniform">
                            <Image.Source>
                                <BitmapImage UriSource="Assets/app-icon.png" DecodePixelWidth="40"/>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="FORGEPANEL" Foreground="{StaticResource AccentSoft}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="    Desktop launcher · Server manager" Foreground="{StaticResource Muted}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <!-- Без этого флагка системная шапка перехватывала бы клики по кнопкам. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"/>
                        <Button Style="{StaticResource MaximizeButton}" Click="Maximize_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <!-- LastChildFill=False обязателен: последний ребёнок DockPanel игнорирует свой
                         Dock и растягивается на всё оставшееся место. Из-за этого блок аккаунта
                         (он последний) занимал всю нижнюю часть сайдбара, а текст внутри
                         центрировался по вертикали — казалось, что он висит посередине. -->
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top" Margin="10,16,10,0">
                            <TextBlock Text="ЛАУНЧЕР" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>

                            <Button x:Name="NavHome" Content="⌂   Главная"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Home_Click"/>

                            <Button x:Name="NavLibrary" Content="▦   Библиотека"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Library_Click"/>

                            <Button x:Name="NavCatalog" Content="◈   Каталог"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Catalog_Click"/>

                            <Button x:Name="NavDownloads" Content="⇩   Загрузки"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Downloads_Click"/>

                            <Button x:Name="NavFiles" Content="▣   Файлы и бэкапы"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Files_Click"/>

                            <Button x:Name="NavMetrics" Content="&#x25D4;   Метрики"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Metrics_Click"/>

                            <Button x:Name="NavSettings" Content="⚙   Настройки"
        HorizontalContentAlignment="Left"
        Margin="0,0,0,5"
        Click="Settings_Click"/>

                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Бейдж с инициалом появляется, когда локальный профиль создан. -->
                                <Border x:Name="SidebarAccountBadge" Grid.Column="0" Width="28" Height="28" CornerRadius="9"
                                        Background="{StaticResource AccentSoftBg}" BorderBrush="{StaticResource AccentSoftLine}" BorderThickness="1"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="SidebarAccountInitial" Foreground="{StaticResource AccentSoft}" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarAccountName" Text="Профиль не создан" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="SidebarAccountNote" Text="Локальный режим · без пароля"
                                               Foreground="{StaticResource Muted}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{StaticResource ToolbarBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Клик по всему полю, а не только по тексту: обработчик на Border
                             перехватывает нажатие до TextBox (Preview-событие идёт сверху вниз),
                             поэтому курсор в поле не появляется и открывается палитра. -->
                        <Border Grid.Column="0"
            x:Name="SearchBox"
            Cursor="Hand"
            PreviewMouseLeftButtonDown="SearchBox_PreviewMouseDown"
            MinHeight="36"
            MaxWidth="480"
            Margin="22,0,20,0"
            VerticalAlignment="Center"
            Background="{StaticResource SearchBg}"
            BorderBrush="{StaticResource SearchLine}"
            BorderThickness="1"
            CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="⌕"
                       Foreground="{StaticResource AccentSoft}"
                       FontSize="21"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

                                <TextBox x:Name="GlobalSearch"
                     Grid.Column="1"
                     Margin="0,1,8,1"
                     Padding="0,4"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource Text}"
                     CaretBrush="{StaticResource AccentSoft}"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     local:Placeholder.Text="Поиск и переходы · Ctrl+K"
                     ToolTip="Поиск по сборкам и переходы по приложению"
                     TextChanged="GlobalSearch_TextChanged"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
            Background="{StaticResource SearchBg}"
            BorderBrush="{StaticResource SearchLine}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4"
            Margin="0,0,26,0"
            VerticalAlignment="Center">
                            <TextBlock Text="FORGEPANEL  /  DESKTOP"
                   Foreground="{StaticResource Muted}"
                   FontSize="10"
                   FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PageRoot" Margin="30,26,30,30" SizeChanged="PageRoot_SizeChanged">
                            <!-- Вторую строку растягиваем только тогда, когда странице это нужно: под
                                 прокруткой (высота бесконечна) звёздочка ведёт себя как Auto, а на
                                 консоли со выключенной прокруткой даёт журналу всю свободную высоту. -->
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel x:Name="PageHeader" Grid.Row="0" Margin="0,0,0,22">
                                <TextBlock x:Name="Eyebrow" Text="ВАШЕ ПРОСТРАНСТВО" Foreground="{StaticResource AccentSoft}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="PageTitle" Text="Добро пожаловать" FontSize="34" FontWeight="Bold" Margin="0,6,0,3"/>
                                <TextBlock x:Name="PageSubtitle" Text="Управляйте игровыми серверами и конфигурациями в одном месте." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                            <ContentControl x:Name="PageContent" Grid.Row="1"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Палитра быстрых команд: содержимое строит CommandPalette.cs. Хост — последний
                     ребёнок и лежит поверх обеих колонок, но не трогает шапку окна: её по-прежнему
                     можно тянуть мышью и нажимать кнопки сверху. -->
                <Grid x:Name="PaletteHost" Grid.ColumnSpan="2" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
